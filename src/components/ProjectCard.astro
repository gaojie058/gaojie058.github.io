---
import { cn } from '@/utils'

interface Props {
	as?: string
	class?: string
	href?: string
	heading: string
	subheading?: string
	imagePath?: string
	altText?: string
	links?: Record<string, string>
}

const { as: Tag = 'a', class: className, href, heading, subheading, imagePath, altText, links } = Astro.props
---

<div class={cn(className, 'flex flex-col overflow-hidden rounded-lg border border-border bg-background transition-all hover:shadow-md')}>
	{imagePath && (
		<img src={imagePath} alt={altText || heading} class='h-48 w-full object-cover' loading='lazy' />
	)}
	<div class='flex flex-col gap-y-2 p-5'>
		<h3 class='text-lg font-bold text-foreground'>{heading}</h3>
		{subheading && <p class='text-sm leading-relaxed text-muted-foreground'>{subheading}</p>}
		{links && Object.keys(links).length > 0 && (
			<div class='mt-2 flex flex-wrap gap-2'>
				{Object.entries(links).map(([label, url]) => (
					<a href={url} target='_blank' rel='noopener noreferrer' class='inline-flex items-center gap-1 rounded-full border border-border px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground'>
						{label}
					</a>
				))}
			</div>
		)}
		<slot />
	</div>
</div>
